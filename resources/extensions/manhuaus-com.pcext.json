{
  "id": "manhuaus.com",
  "name": "ManhuaUS",
  "lang": "en",
  "version": "1.0.1",
  "baseUrl": "https://manhuaus.com",
  "kind": "html",
  "nsfw": false,
  "config": {
    "render": true
  },
  "popular": {
    "url": "{baseUrl}/manga/page/{page}/?m_orderby=views",
    "item_selector": "div.page-item-detail, a[href*='/manga/']:has(img)",
    "title_selector": "img@alt || .tt || h3 || a@title",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "latest": {
    "url": "{baseUrl}/manga/page/{page}/?m_orderby=views",
    "item_selector": "div.page-item-detail, a[href*='/manga/']:has(img)",
    "title_selector": "img@alt || .tt || h3 || a@title",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "search": {
    "url": "{baseUrl}/?s={query}",
    "item_selector": "div.page-item-detail, a[href*='/manga/']:has(img)",
    "title_selector": "img@alt || .tt || h3 || a@title",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "details": {
    "url": "{mangaUrl}",
    "title_selector": "meta[property='og:title']@content || h1 || .entry-title",
    "description_selector": "meta[property='og:description']@content",
    "thumbnail_selector": "meta[property='og:image']@content",
    "thumbnail_attr": "content"
  },
  "chapters": {
    "url": "{mangaUrl}",
    "item_selector": "li.wp-manga-chapter, #chapterlist li, a[href*='/chapter']",
    "name_selector": ".chapternum || a || ",
    "number_selector": ".chapternum || a || ",
    "url_selector": "",
    "url_attr": "href"
  },
  "pages": {
    "url": "{chapterUrl}",
    "image_selector": "#readerarea img, .reading-content img, img[src*='/upload'], img[src*='/storage'], img[src*='/chapter']",
    "image_attr": "src"
  }
}