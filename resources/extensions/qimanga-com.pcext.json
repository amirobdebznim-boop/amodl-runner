{
  "id": "qimanga.com",
  "name": "Qi Manga",
  "lang": "en",
  "version": "1.0.0",
  "baseUrl": "https://qimanga.com",
  "kind": "html",
  "nsfw": false,
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
  "_note": "JSON-API SPA (api.qimanga.com, HeanCMS-style). Browse/popular/latest via config.browseApi (/api/v1/series?sort=popular); search via config.searchApi (/api/v1/series/search?q=); details scraped from the server-rendered og: meta on the /series/{slug} page; chapters via config.chaptersApi (/api/v1/series/{slug}/chapters, perPage capped at 100); pages via config.pagesApi (/api/v1/series/{slug}/chapters/{chapterSlug}, images[].url). Covers + page images are absolute media.qimanga.com/media.qimanhwa.com URLs, fetchable UA-only.",
  "popular": {
    "url": "{baseUrl}/browse?page={page}",
    "item_selector": "a[href^='/series/']:has(img)",
    "title_selector": "img@alt",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "latest": {
    "url": "{baseUrl}/browse?page={page}",
    "item_selector": "a[href^='/series/']:has(img)",
    "title_selector": "img@alt",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "search": {
    "url": "{baseUrl}/browse?page={page}&query={query}",
    "item_selector": "a[href^='/series/']:has(img)",
    "title_selector": "img@alt",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "details": {
    "url": "{mangaUrl}",
    "title_selector": "meta[property='og:title']@content || h1",
    "description_selector": "meta[property='og:description']@content",
    "thumbnail_selector": "meta[property='og:image']@content",
    "thumbnail_attr": "content"
  },
  "chapters": {
    "url": "{mangaUrl}",
    "item_selector": "a[href*='/chapter']",
    "name_selector": "",
    "number_selector": "",
    "url_selector": "",
    "url_attr": "href"
  },
  "pages": {
    "url": "{chapterUrl}",
    "image_selector": "img",
    "image_attr": "src"
  },
  "config": {
    "browseApi": {
      "url": "https://api.qimanga.com/api/v1/series?page={page}&perPage=24&sort=popular",
      "items": "data",
      "title": "title",
      "slug": "slug",
      "cover": "cover",
      "seriesPath": "/series/{slug}"
    },
    "searchApi": {
      "url": "https://api.qimanga.com/api/v1/series/search?q={query}&page={page}&perPage=24",
      "items": "data",
      "title": "title",
      "slug": "slug",
      "cover": "cover",
      "seriesPath": "/series/{slug}"
    },
    "chaptersApi": {
      "url": "https://api.qimanga.com/api/v1/series/{mangaSlug}/chapters?perPage=100",
      "items": "data",
      "name": "title",
      "slug": "slug",
      "date": "createdAt",
      "chapterPath": "/series/{mangaSlug}/{slug}"
    },
    "pagesApi": {
      "url": "https://api.qimanga.com/api/v1/series/{mangaSlug}/chapters/{chapterSlug}",
      "items": "images",
      "image_field": "url"
    }
  }
}
