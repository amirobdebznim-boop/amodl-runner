{
  "id": "lagoonscans.com",
  "name": "Lagoon Scans",
  "lang": "en",
  "version": "1.0.0",
  "baseUrl": "https://lagoonscans.com",
  "kind": "html",
  "nsfw": false,
  "popular": {
    "url": "{baseUrl}/manga/?order=popular&page={page}",
    "item_selector": "div.bsx",
    "title_selector": "a@title || .tt",
    "url_selector": "a",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "latest": {
    "url": "{baseUrl}/manga/?order=update&page={page}",
    "item_selector": "div.bsx",
    "title_selector": "a@title || .tt",
    "url_selector": "a",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "search": {
    "url": "{baseUrl}/manga/?title={query}&page={page}",
    "item_selector": "div.bsx",
    "title_selector": "a@title || .tt",
    "url_selector": "a",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "details": {
    "url": "{mangaUrl}",
    "title_selector": "h1.entry-title || meta[property='og:title']@content",
    "description_selector": "div[itemprop='description'] || .entry-content",
    "thumbnail_selector": "img.wp-post-image || meta[property='og:image']@content",
    "thumbnail_attr": "src"
  },
  "chapters": {
    "url": "{mangaUrl}",
    "item_selector": "#chapterlist li, div.eplister li",
    "name_selector": ".chapternum",
    "number_selector": "@data-num",
    "date_selector": ".chapterdate",
    "url_selector": "a",
    "url_attr": "href"
  },
  "pages": {
    "url": "{chapterUrl}",
    "image_selector": "#readerarea img",
    "image_attr": "src"
  }
}
