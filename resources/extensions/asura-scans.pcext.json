{
  "id": "asuracomic.net",
  "name": "Asura Scans",
  "lang": "en",
  "version": "1.2.1",
  "baseUrl": "https://asurascans.com",
  "kind": "html",
  "user_agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 13_6) AppleWebKit/605.1.15 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/605.1.15 AmoDL/0.2",
  "nsfw": false,
  "_note": "Asura moved asuracomic.net → asurascans.com (the old domain 301s chapter URLs to the bare root, losing the path → reader became the catalog). Live domain is plain-GET (no CF) so render:false; listing is /browse, reader images keep the /asura-images/chapters/ path. Search uses api.asurascans.com/api/series.",
  "config": {
    "render": false,
    "searchApi": {
      "url": "https://api.asurascans.com/api/series?search={query}&offset={offset}&limit=20",
      "items": "data",
      "title": "title",
      "slug": "public_url",
      "cover": "cover",
      "seriesPath": "{slug}",
      "pageSize": 20
    }
  },
  "popular": {
    "url": "{baseUrl}/browse?page={page}",
    "item_selector": "a.col-span-4[href*='/comics/'], a[href*='/comics/']:has(img)",
    "title_selector": "img@alt",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "latest": {
    "url": "{baseUrl}/browse?page={page}",
    "item_selector": "a.col-span-4[href*='/comics/'], a[href*='/comics/']:has(img)",
    "title_selector": "img@alt",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "search": {
    "url": "{baseUrl}/browse?page={page}&name={query}",
    "item_selector": "a.col-span-4[href*='/comics/'], a[href*='/comics/']:has(img)",
    "title_selector": "img@alt",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "details": {
    "url": "{mangaUrl}",
    "title_selector": "h1.font-semibold, h1:not(.sr-only)",
    "description_selector": "span.font-medium.text-sm, div[class*='Summary'] p, p.font-medium",
    "author_selector": "h3:-soup-contains(Author) + h3",
    "artist_selector": "h3:-soup-contains(Artist) + h3",
    "genre_selector": "div.flex.flex-row.flex-wrap.gap-2 button, a[href*='genres=']",
    "status_selector": "h3:-soup-contains(Status) + h3",
    "thumbnail_selector": "meta[property='og:image']@content || img[alt*='poster'] || img[src*='/covers/']",
    "thumbnail_attr": "content"
  },
  "chapters": {
    "url": "{mangaUrl}",
    "item_selector": "a.group[href*='/chapter/']",
    "name_selector": "span.font-medium",
    "url_selector": "",
    "url_attr": "href",
    "date_selector": "span.text-white\\/40"
  },
  "pages": {
    "url": "{chapterUrl}",
    "image_selector": "img[src*='/asura-images/chapters/']",
    "image_attr": "src"
  }
}