{
  "id": "rumanhua2.com",
  "name": "如漫画 Rumanhua",
  "lang": "zh",
  "version": "1.0.0",
  "baseUrl": "http://www.rumanhua2.com",
  "kind": "html",
  "nsfw": false,
  "config": {
    "render": false,
    "searchPostField": "k",
    "note": "qTcms Chinese reader — manga ids are JS-encoded, reader images are delivered via a signed /read_s request. Static scraping is blocked; requires a CloakBrowser/CDP solver (Settings → Network) that runs the site's JS, handles cookies and signing, and exposes the rendered images. Search is a client-side `<form method=post>` (jQuery `StandardPost('/s', k)`), not a GET query string — hence `searchPostField`."
  },
  "popular": {
    "item_selector": "div.likedata",
    "title_selector": ".le-t || img@alt",
    "url_selector": ".likeimg a",
    "url_attr": "href",
    "thumbnail_selector": ".likeimg img",
    "thumbnail_attr": "data-src",
    "url": "{baseUrl}/rank/1"
  },
  "latest": {
    "item_selector": "div.likedata",
    "title_selector": ".le-t || img@alt",
    "url_selector": ".likeimg a",
    "url_attr": "href",
    "thumbnail_selector": ".likeimg img",
    "thumbnail_attr": "data-src",
    "url": "{baseUrl}/sort/1"
  },
  "search": {
    "item_selector": "div.col-auto a",
    "title_selector": "p.e-title",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src",
    "url": "{baseUrl}/s"
  },
  "details": {
    "url": "{mangaUrl}",
    "title_selector": "h1 || .comic-title || meta[property='og:title']@content",
    "description_selector": ".comic-intro || .intro",
    "thumbnail_selector": "meta[property='og:image']@content || .cartoon-poster",
    "thumbnail_attr": "content"
  },
  "chapters": {
    "url": "{mangaUrl}",
    "item_selector": "div.chapter-list a, ul.chapter a, a[href*='.html']",
    "name_selector": "li || ",
    "url_selector": "",
    "url_attr": "href"
  },
  "pages": {
    "url": "{chapterUrl}",
    "image_selector": "img[src*='ecombdimg'], #cp_img img, .comiclist img, .chapter-content img, #images img, img.lazy",
    "image_attr": "src"
  }
}