{
  "id": "shonenjumpplus.com",
  "name": "少年ジャンプ+ Shonen Jump+",
  "lang": "ja",
  "version": "1.0.0",
  "baseUrl": "https://shonenjumpplus.com",
  "kind": "gigaviewer",
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0 AmoDL/0.3",
  "nsfw": false,
  "popular": {
    "url": "{baseUrl}/series",
    "item_selector": "ul.series-list li a",
    "title_selector": "h2.series-list-title",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "div.series-list-thumb img",
    "thumbnail_attr": "src"
  },
  "search": {
    "url": "{baseUrl}/search?q={query}",
    "item_selector": "ul.search-series-list li, ul.series-list li",
    "title_selector": "div.title-box p.series-title",
    "url_selector": "div.thmb-container a",
    "url_attr": "href",
    "thumbnail_selector": "div.thmb-container a img",
    "thumbnail_attr": "src"
  },
  "details": {
    "url": "{mangaUrl}",
    "title_selector": "h1.series-header-title",
    "description_selector": "p.series-header-description",
    "author_selector": "h2.series-header-author",
    "thumbnail_selector": "div.series-header-image-wrapper img",
    "thumbnail_attr": "src"
  },
  "chapters": {
    "url": "{mangaUrl}",
    "item_selector": "_api"
  },
  "pages": {
    "url": "{chapterUrl}",
    "image_selector": "_api"
  },
  "config": {
    "pageSize": 15
  }
}
