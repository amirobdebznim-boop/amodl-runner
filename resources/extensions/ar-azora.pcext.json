{
  "id": "azoramoon.com",
  "name": "Azora Moon",
  "lang": "ar",
  "version": "1.0.1",
  "baseUrl": "https://azorafly.com",
  "kind": "html",
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0 AmoDL/0.3",
  "nsfw": false,
  "popular": {
    "url": "{baseUrl}/series/?page={page}",
    "item_selector": "a[href*='/series/']:has(img)",
    "title_selector": "img@alt || h3 || span",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "latest": {
    "url": "{baseUrl}/series/?page={page}&orderBy=latest",
    "item_selector": "a[href*='/series/']:has(img)",
    "title_selector": "img@alt || h3 || span",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "search": {
    "url": "{baseUrl}/series?query={query}&page={page}",
    "item_selector": "a[href*='/series/']:has(img)",
    "title_selector": "img@alt || h3 || span",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "details": {
    "url": "{mangaUrl}",
    "title_selector": "h1 || img@alt",
    "description_selector": "p || div.description",
    "genre_selector": "a[href*='/genre'], .genre",
    "thumbnail_selector": "img",
    "thumbnail_attr": "src"
  },
  "chapters": {
    "url": "{mangaUrl}",
    "item_selector": "a[href*='chapter-'], a[href*='-chapter-']",
    "name_selector": "",
    "url_selector": "",
    "url_attr": "href"
  },
  "pages": {
    "url": "{chapterUrl}",
    "image_selector": "div#readerarea img, img[src*='storage.azorafly.com'], img[src*='storage.azoramoon.com'], img[src*='/WP-manga/'], img[src*='/wp-manga/']",
    "image_attr": "src"
  }
}
