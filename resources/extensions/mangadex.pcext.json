{
  "id": "mangadex.org",
  "name": "MangaDex",
  "lang": "en",
  "version": "1.1.0",
  "baseUrl": "https://api.mangadex.org",
  "kind": "json",
  "user_agent": "AmoDL/0.3 (+https://github.com/amodl)",
  "nsfw": false,

  "popular": {
    "url": "{baseUrl}/manga?order[followedCount]=desc&limit=24&offset={offset}&availableTranslatedLanguage[]=en&hasAvailableChapters=true&excludedOriginalLanguage[]=ko&excludedOriginalLanguage[]=zh&excludedOriginalLanguage[]=zh-hk&includes[]=cover_art",
    "item_selector": "data[]",
    "title_selector": "attributes.title.en || attributes.title.ja-ro || attributes.title.ja || attributes.title.ko || attributes.title.ko-ro || attributes.title.zh || attributes.title.zh-ro || attributes.altTitles.0.en || id",
    "url_selector": "id"
  },

  "latest": {
    "url": "{baseUrl}/manga?order[latestUploadedChapter]=desc&limit=24&offset={offset}&availableTranslatedLanguage[]=en&hasAvailableChapters=true&excludedOriginalLanguage[]=ko&excludedOriginalLanguage[]=zh&includes[]=cover_art",
    "item_selector": "data[]",
    "title_selector": "attributes.title.en || attributes.title.ja-ro || attributes.title.ja || attributes.title.ko || attributes.title.ko-ro || attributes.title.zh || id",
    "url_selector": "id"
  },

  "search": {
    "url": "{baseUrl}/manga?title={query}&limit=24&offset={offset}&availableTranslatedLanguage[]=en&includes[]=cover_art",
    "item_selector": "data[]",
    "title_selector": "attributes.title.en || attributes.title.ja-ro || attributes.title.ja || attributes.title.ko || attributes.title.ko-ro || attributes.title.zh || id",
    "url_selector": "id"
  },

  "details": {
    "url": "{baseUrl}/manga/{mangaUrl}?includes[]=cover_art&includes[]=author&includes[]=artist",
    "title_selector": "data.attributes.title.en || data.attributes.title.ja-ro || data.attributes.title.ja",
    "description_selector": "data.attributes.description.en",
    "status_selector": "data.attributes.status"
  },

  "chapters": {
    "url": "{baseUrl}/manga/{mangaUrl}/feed?translatedLanguage[]=en&order[chapter]=desc&limit=200&includeFutureUpdates=0",
    "item_selector": "data[]",
    "name_selector": "attributes.title || attributes.chapter",
    "url_selector": "id",
    "number_selector": "attributes.chapter",
    "date_selector": "attributes.publishAt"
  },

  "pages": {
    "url": "{baseUrl}/at-home/server/{chapterUrl}",
    "image_selector": "chapter.data[]",
    "image_attr": ""
  }
}
