{
  "id": "mangapill.com",
  "name": "MangaPill",
  "lang": "en",
  "version": "1.1.0",
  "baseUrl": "https://mangapill.com",
  "kind": "html",
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AmoDL/0.3",
  "nsfw": false,

  "popular": {
    "url": "{baseUrl}/search?q=&type=manga&status=&page={page}",
    "item_selector": "div.my-3.grid > div",
    "title_selector": "div a[href*='/manga/'] || img@alt",
    "url_selector": "a[href*='/manga/']",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "data-src"
  },

  "latest": {
    "url": "{baseUrl}/chapters",
    "item_selector": "div.grid > div",
    "title_selector": "div a[href*='/manga/'] || img@alt",
    "url_selector": "a[href*='/manga/']",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "data-src"
  },

  "search": {
    "url": "{baseUrl}/search?q={query}&page={page}",
    "item_selector": "div.my-3.grid > div",
    "title_selector": "div a[href*='/manga/'] || img@alt",
    "url_selector": "a[href*='/manga/']",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "data-src"
  },

  "details": {
    "url": "{mangaUrl}",
    "title_selector": "h1",
    "description_selector": "p.text-sm",
    "genre_selector": "a[href*='/search?genre']",
    "thumbnail_selector": "img.border",
    "thumbnail_attr": "data-src"
  },

  "chapters": {
    "url": "{mangaUrl}",
    "item_selector": "div#chapters a[href*='/chapters/']",
    "name_selector": "",
    "url_selector": "",
    "url_attr": "href"
  },

  "pages": {
    "url": "{chapterUrl}",
    "image_selector": "picture img, img.js-page",
    "image_attr": "data-src"
  }
}
