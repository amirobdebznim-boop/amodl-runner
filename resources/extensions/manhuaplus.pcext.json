{
  "id": "manhuaplus.org",
  "name": "ManhuaPlus",
  "lang": "en",
  "version": "1.0.0",
  "baseUrl": "https://manhuaplus.org",
  "kind": "html",
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0 AmoDL/0.3",
  "nsfw": false,
  "popular": {
    "url": "{baseUrl}/manga/?m_orderby=trending&page={page}",
    "item_selector": "a[href*='/manga/']",
    "title_selector": "img@alt",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "data-src"
  },
  "latest": {
    "url": "{baseUrl}/manga/?m_orderby=latest&page={page}",
    "item_selector": "a[href*='/manga/']",
    "title_selector": "img@alt",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "data-src"
  },
  "search": {
    "url": "{baseUrl}/?s={query}&post_type=wp-manga",
    "item_selector": "a[href*='/manga/']",
    "title_selector": "img@alt",
    "url_selector": "",
    "url_attr": "href",
    "thumbnail_selector": "img",
    "thumbnail_attr": "data-src"
  },
  "details": {
    "url": "{mangaUrl}",
    "title_selector": "header h1",
    "description_selector": "#syn-target, div.summary__content, div.description-summary",
    "author_selector": "#extra-target .dt a, div.author-content a",
    "genre_selector": "a.label, div.genres-content a",
    "thumbnail_selector": "figure.mb-15 img, div.summary_image img",
    "thumbnail_attr": "src"
  },
  "chapters": {
    "url": "{mangaUrl}",
    "item_selector": "li.chapter a, ul.list-chapters li a, li.wp-manga-chapter a",
    "name_selector": "",
    "url_selector": "",
    "url_attr": "href"
  },
  "pages": {
    "url": "{chapterUrl}",
    "image_selector": "div.reading-content img, div.chapter-content img, div.page-break img, img.wp-manga-chapter-img",
    "image_attr": "data-src"
  },
  "config": {
    "ajax_pages": {
      "id_rx": "CHAPTER_ID\\s*=\\s*(\\d+)",
      "url": "{baseUrl}/ajax/image/list/chap/{id}",
      "json_field": "html",
      "image_attr": "src"
    }
  }
}